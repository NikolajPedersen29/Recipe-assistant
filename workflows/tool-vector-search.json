    },
    {
      "parameters": {
        "jsCode": "// Laver Neo4j's svar om til en læsbar liste til agenten\nconst res = $input.first().json;\nif (res.errors && res.errors.length) {\n  return [{ json: { error: res.errors.map(e => e.message).join('; ') } }];\n}\nconst r = res.results[0];\nconst rows = r.data.map(d => Object.fromEntries(r.columns.map((c, i) => [c, d.row[i]])));\nreturn [{ json: { count: rows.length, results: rows } }];"
      },
