        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Bygger vektorsøgningen og beriger hvert hit med fakta fra grafen\nconst input = $('Start').first().json;\nconst k = Math.max(1, Math.min(20, Math.round(Number(input.k) || 5)));\nconst embedding = $input.first().json.embeddings[0];\nconst statement = [\n  \"CALL db.index.vector.queryNodes('recipe_chunks', $k, $embedding) YIELD node, score\",\n  \"MATCH (node)-[:PART_OF]->(r:Recipe)\",\n  \"OPTIONAL MATCH (r)-[:IN_CATEGORY]->(c:Category)\",\n  \"RETURN r.id AS recipeId, r.name AS name, round(score, 3) AS score,\",\n  \"  r.totalTime AS minutes, r.rating AS rating, c.name AS category,\",\n  \"  [(r)-[:HAS_INGREDIENT]->(i) | i.name] AS ingredients,\",\n  \"  [(r)-[:HAS_TAG]->(t) | t.name] AS tags,\",\n  \"  node.text AS text, node.source AS source\",\n  \"ORDER BY score DESC\"\n].join(' ');\nreturn [{ json: { statements: [{ statement, parameters: { k, embedding } }] } }];"
      },
      "id": "b1000000-0000-4000-8000-000000000003",
      "name": "Byg vektor-Cypher",
      "type": "n8n-nodes-base.code",
